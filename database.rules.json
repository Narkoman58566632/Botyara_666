{
  "rules": {
    ".read": false,
    ".write": false,

    "channels": {
      "$nick": {
        ".read": "auth != null && root.child('links').child($nick).child(auth.uid).val() === true",
        ".write": "auth != null && data.exists() && newData.exists() && root.child('links').child($nick).child(auth.uid).val() === true",
        ".validate": "$nick.matches(/^[a-z0-9_]{3,25}$/) && newData.hasChildren()",

        "name": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 16"
        },
        "tag": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9]{3,5}$/)"
        },
        "region": {
          ".validate": "newData.val() === 'eu' || newData.val() === 'na' || newData.val() === 'ap' || newData.val() === 'kr'"
        },
        "enabled": {
          ".validate": "newData.isBoolean()"
        },
        "timerOff": {
          ".validate": "newData.isBoolean()"
        },
        "timerInterval": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1440 && newData.val() % 1 === 0"
        },
        "commands": {
          "$cmd": {
            ".validate": "$cmd.matches(/^![^ ]{1,20}$/) && $cmd === $cmd.toLowerCase() && newData.isString() && newData.val().length >= 1 && newData.val().length <= 400 && !newData.val().matches(/^[ ]*[\\/.]/)"
          }
        },
        "timers": {
          "$i": {
            ".validate": "$i.matches(/^([0-9]|1[0-9])$/) && newData.isString() && newData.val().length >= 1 && newData.val().length <= 400 && !newData.val().matches(/^[ ]*[\\/.]/)"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },

    "linkRequests": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['token', 'createdAt'])",

        "token": {
          ".validate": "newData.isString() && newData.val().length >= 20 && newData.val().length <= 64 && newData.val().matches(/^[A-Za-z0-9]+$/)"
        },
        "createdAt": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
